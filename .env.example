# Public web UI port
WEB_PORT=8088

# Required: OpenAI-compatible 9Router base URL. No key is bundled in source.
ROUTER_BASE_URL=https://9router.ahmadlab.my.id/v1
ROUTER_API_KEY=replace_with_your_api_key
ROUTER_MODEL=model-custom

# Optional Hermes status/log API. Configure only if you have a real API endpoint.
# These endpoints are NOT assumed to exist. Set them to routes provided by your Hermes deployment.
HERMES_BASE_URL=
HERMES_STATUS_PATH=
HERMES_LOGS_PATH=
HERMES_BEARER_TOKEN=

# Optional: allow only HTTPS or private HTTP endpoints as appropriate for your network.
REQUEST_TIMEOUT_MS=5000
